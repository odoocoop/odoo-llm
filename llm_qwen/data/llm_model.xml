<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Qwen Cloud Models -->
    <record id="llm_model_qwen_max" model="llm.model">
        <field name="name">qwen-max</field>
        <field name="provider_id" ref="llm_provider_qwen_cloud" />
        <field name="publisher_id" ref="llm_publisher_qwen" />
        <field name="model_use">chat</field>
        <field name="default" eval="True" />
        <field name="active" eval="True" />
    </record>

    <record id="llm_model_qwen_plus" model="llm.model">
        <field name="name">qwen-plus</field>
